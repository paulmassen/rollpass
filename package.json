{
  "name": "rollpass",
  "private": true,
  "version": "1.0.0",
  "description": "Passwords that are fast to type: finger alternation, unique keys, one-handed mode. 100% local.",
  "author": "Paul Massendari",
  "license": "MIT",
  "keywords": [
    "password",
    "password-generator",
    "typing",
    "keyboard",
    "one-handed",
    "azerty",
    "qwerty",
    "dvorak"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulmassen/rollpass.git"
  },
  "homepage": "https://paulmassen.github.io/rollpass/",
  "bugs": {
    "url": "https://github.com/paulmassen/rollpass/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "predeploy": "npm run lint && npm test && npm run build",
    "deploy": "gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.3"
  }
}
